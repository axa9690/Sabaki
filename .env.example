# Copy to .env and fill in your own values. Never commit .env.

# --- LLM provider ---------------------------------------------------------
# groq (cloud, default) | ollama (local, optional compatibility mode)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Required when LLM_PROVIDER=groq. Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional LLM tuning (defaults shown)
# LLM_TEMPERATURE=0.0
# LLM_MAX_OUTPUT_TOKENS=200
# LLM_TIMEOUT_S=30
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF_S=0.5
# GROQ_BASE_URL=

# Optional local Ollama mode
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT_S=180

# --- Gmail ----------------------------------------------------------------
GMAIL_CLIENT_SECRET_PATH=secrets/gmail_oauth_client.json
GMAIL_TOKEN_PATH=secrets/gmail_token.json
# Cloud deployments can pass the token contents instead of a file:
# GMAIL_TOKEN_JSON={"token": "...", "refresh_token": "..."}

# --- Workflow -------------------------------------------------------------
MAX_EMAILS=50
# Shared secret required by the POST /run endpoint (X-API-Key header)
# RUN_API_KEY=
